{"nodes": [{"id": "docs_superpowers_reports_task_6a_report", "label": "Task 6a Report: Template-to-JSX Converter", "file_type": "document", "source_file": "docs/superpowers/reports/task-6a-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_reports_task_6a_report_template_to_jsx_converter", "label": "Template-to-JSX Converter", "file_type": "concept", "source_file": "docs/superpowers/reports/task-6a-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "convert(html, assets) turns sliced template bodies into JSX: style/style-hover to className, HTML attr renames, viewBox restore, image-slot to img, void self-closing, link routing, brace escaping."}, {"id": "docs_superpowers_reports_task_6a_report_node_html_parser", "label": "node-html-parser", "file_type": "concept", "source_file": "docs/superpowers/reports/task-6a-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_reports_task_6a_report_brace_escape_bug", "label": "Sequential Replace Brace-Escaping Bug", "file_type": "concept", "source_file": "docs/superpowers/reports/task-6a-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chained .replace() calls re-mangled each other's inserted {'{'} output; replaced with a single-pass replacer function. Real templates contain zero braces, so only the synthetic test covers it."}, {"id": "docs_superpowers_reports_task_6a_report_route_suffix_gap", "label": "ROUTES .dc.html vs Bare .html Link Gap", "file_type": "concept", "source_file": "docs/superpowers/reports/task-6a-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Home uses .dc.html links, the other six pages use bare .html (plus one #fragment link); the exact-match table left 82 of 96 internal links unconverted."}, {"id": "docs_superpowers_reports_task_6a_report_toroute_normalisation", "label": "Suffix/Fragment-Agnostic toRoute with PAGE_ROUTES", "file_type": "concept", "source_file": "docs/superpowers/reports/task-6a-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Regex accepts optional .dc and preserves #fragment; unmapped Arohance-prefixed hrefs (href only, not alt) are collected and thrown once so the CLI exits non-zero."}, {"id": "docs_superpowers_reports_task_6a_report_completeness_guard", "label": "Converter Completeness Guard", "file_type": "rationale", "source_file": "docs/superpowers/reports/task-6a-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Throws on any surviving hyphenated custom element or style-/sc- attribute so unknown constructs fail loudly instead of a per-instance patch cycle; KNOWN_TAGS holds only x-dc so broken renames of image-slot/sc-raw-select are still caught."}, {"id": "docs_superpowers_reports_task_6a_report_style_focus_variant", "label": "style-focus to focus: Variant", "file_type": "concept", "source_file": "docs/superpowers/reports/task-6a-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_reports_task_6a_report_sc_raw_select", "label": "sc-raw-select to select Rename", "file_type": "concept", "source_file": "docs/superpowers/reports/task-6a-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_reports_task_6a_report_whole_string_equality", "label": "Whole-String Equality Assertions", "file_type": "rationale", "source_file": "docs/superpowers/reports/task-6a-report.md", "source_location": null, "source_url": null, "