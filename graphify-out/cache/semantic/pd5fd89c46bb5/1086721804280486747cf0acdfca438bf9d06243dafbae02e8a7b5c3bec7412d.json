{"nodes": [{"id": "docs_superpowers_reports_task_1_report", "label": "Task 1 Report: Unbundle Artifacts into Templates and Assets", "file_type": "document", "source_file": "docs/superpowers/reports/task-1-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_reports_task_1_report_arohance_html_bundles", "label": "Seven Arohance HTML Bundles (source artifacts)", "file_type": "concept", "source_file": "docs/superpowers/reports/task-1-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read-only design-tool exports (home, about, services, studio, careers, contact, case-study); kept byte-for-byte untouched and used as the fidelity reference for the whole port."}, {"id": "docs_superpowers_reports_task_1_report_content_hash_dedup", "label": "Content-Hash Asset Deduplication", "file_type": "rationale", "source_file": "docs/superpowers/reports/task-1-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sha1 truncated to 10 hex chars dedupes the 187 manifest entries across seven bundles down to 38 distinct files (33 images + 5 vendor scripts)."}, {"id": "docs_superpowers_reports_task_1_report_vendor_fingerprinting", "label": "Vendor Library Fingerprinting", "file_type": "rationale", "source_file": "docs/superpowers/reports/task-1-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JS assets matched against 5 signatures (three.js, GSAP, liquid-ether, stroke-text, contact-pill) are kept in .source/vendor; React, ReactDOM, dc-runtime and the image-slot authoring component are recorded as null."}, {"id": "docs_superpowers_reports_task_1_report_null_asset_policy", "label": "Null Asset Policy (fonts and runtime internals)", "file_type": "rationale", "source_file": "docs/superpowers/reports/task-1-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WOFF2 fonts are dropped because a later task loads them via next/font/google; null entries mean tests must check key presence, not truthiness."}, {"id": "docs_superpowers_reports_task_1_report_asset_map", "label": "assets.json UUID-to-Path Asset Map", "file_type": "concept", "source_file": "docs/superpowers/reports/task-1-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_reports_task_1_report_contact_pill_variant_collision", "label": "contact-pill.js Cross-Bundle Variant Collision", "file_type": "concept", "source_file": "docs/superpowers/reports/task-1-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Homepage bundle embeds a contact-pill variant with stale .dc.html href logic; two content hashes map to one filename, producing the 39-vs-38 asset count and a last-write-wins race. The href logic was flagged for replacement with real Next.js routing."}, {"id": "docs_superpowers_reports_task_1_report_content_gated_first_write_wins", "label": "Content-Gated First-Write-Wins Vendor Write", "file_type": "rationale", "source_file": "docs/superpowers/reports/task-1-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makes vendor collisions deterministic (alphabetical About wins, six-page majority variant) and loud (console.warn); gated on byte comparison because an existence-only check warned on every library during warm re-runs."}], "edges": [{"source": "docs_superpowers_reports_task_1_report", "target": "docs_superpowers_reports_task_1_report_arohance_html_bundles", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/